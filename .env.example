# Copy to .env.local and fill in. .env.local is gitignored.
#
# The Anthropic SDK reads this automatically — the code never takes a key as an
# argument and never writes one to a file.
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Defaults to claude-opus-4-8.
# PIPELINE_MODEL=claude-opus-4-8

# Optional. Set to "mock" to run the whole pipeline against committed fixtures
# with no API calls — useful for UI work and for reviewers without a key.
# PIPELINE_MODE=live
